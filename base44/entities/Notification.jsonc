{
  "name": "Notification",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Recipient user ID (trainer or client)"
    },
    "client_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "check_in",
        "form_submitted",
        "form_overdue",
        "subscription_expiring",
        "plan_updated",
        "workout_assigned",
        "nutrition_assigned",
        "follow_up",
        "ai_analysis",
        "application_approved",
        "application_rejected",
        "more_info_requested",
        "client_invited",
        "general"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "related_entity_type": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered",
        "failed"
      ],
      "default": "pending"
    },
    "delivery_channel": {
      "type": "string",
      "enum": [
        "in_app",
        "telegram",
        "both"
      ],
      "default": "in_app"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "type",
    "title",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}