{
  "name": "MetricEntry",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "workspace_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "assigned_ybs_coach_id": {
      "type": "string"
    },
    "trainer_id": {
      "type": "string"
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "weight": {
      "type": "number"
    },
    "height": {
      "type": "number"
    },
    "body_fat": {
      "type": "number"
    },
    "neck": {
      "type": "number"
    },
    "chest": {
      "type": "number"
    },
    "waist": {
      "type": "number"
    },
    "hip": {
      "type": "number"
    },
    "right_arm": {
      "type": "number"
    },
    "left_arm": {
      "type": "number"
    },
    "right_thigh": {
      "type": "number"
    },
    "left_thigh": {
      "type": "number"
    },
    "right_calf": {
      "type": "number"
    },
    "left_calf": {
      "type": "number"
    },
    "custom_measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "progress_photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_analysis": {
      "type": "string"
    },
    "ai_analysis_hash": {
      "type": "string"
    },
    "ai_analysis_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workspace_id",
    "client_id",
    "entry_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        },
        {
          "data.trainer_id": "{{user.id}}"
        },
        {
          "data.assigned_ybs_coach_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.data.self_client_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        },
        {
          "data.trainer_id": "{{user.id}}"
        },
        {
          "data.assigned_ybs_coach_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.data.self_client_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        },
        {
          "data.trainer_id": "{{user.id}}"
        },
        {
          "data.assigned_ybs_coach_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        }
      ]
    }
  }
}