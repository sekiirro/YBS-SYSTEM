{
  "name": "WorkoutPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "workspace_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "null for templates"
    },
    "client_name": {
      "type": "string"
    },
    "assigned_ybs_coach_id": {
      "type": "string"
    },
    "trainer_id": {
      "type": "string"
    },
    "split_type": {
      "type": "string",
      "enum": [
        "full_body",
        "upper_lower",
        "push_pull_legs",
        "arnold_split",
        "bro_split",
        "push_pull",
        "custom"
      ]
    },
    "is_template": {
      "type": "boolean",
      "default": false
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day_name": {
            "type": "string"
          },
          "exercises": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "exercise_id": {
                  "type": "string"
                },
                "exercise_name": {
                  "type": "string"
                },
                "video_url": {
                  "type": "string"
                },
                "sets": {
                  "type": "number"
                },
                "rep_range": {
                  "type": "string"
                },
                "rest_seconds": {
                  "type": "number"
                },
                "weight": {
                  "type": "string"
                },
                "warmup": {
                  "type": "boolean",
                  "default": false
                },
                "rpe": {
                  "type": "number"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "split_type",
    "workspace_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        },
        {
          "data.trainer_id": "{{user.id}}"
        },
        {
          "data.assigned_ybs_coach_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.data.self_client_id}}"
        },
        {
          "$and": [
            {
              "data.is_template": true
            },
            {
              "data.is_archived": false
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        },
        {
          "data.trainer_id": "{{user.id}}"
        },
        {
          "data.assigned_ybs_coach_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        },
        {
          "data.trainer_id": "{{user.id}}"
        },
        {
          "data.assigned_ybs_coach_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        }
      ]
    }
  }
}