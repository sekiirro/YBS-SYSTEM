{
  "name": "Food",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "serving_unit": {
      "type": "string"
    },
    "serving_size": {
      "type": "number"
    },
    "calories": {
      "type": "number"
    },
    "protein": {
      "type": "number"
    },
    "carbs": {
      "type": "number"
    },
    "fat": {
      "type": "number"
    },
    "fiber": {
      "type": "number"
    },
    "sugar": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "protein",
        "carbs",
        "fats",
        "vegetables",
        "fruits",
        "dairy",
        "beverages",
        "other"
      ]
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "serving_unit",
    "calories",
    "protein",
    "carbs",
    "fat"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}