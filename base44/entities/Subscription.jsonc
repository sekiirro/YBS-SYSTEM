{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "workspace_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_code": {
      "type": "string"
    },
    "assigned_ybs_coach_id": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "trainer_id": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "expiring_soon",
        "renewed",
        "extended",
        "frozen",
        "cancelled"
      ],
      "default": "active"
    },
    "price": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "partially_paid",
        "unpaid"
      ],
      "default": "unpaid"
    },
    "renewed_from": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "client_id",
    "package_id",
    "start_date",
    "end_date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        },
        {
          "data.trainer_id": "{{user.id}}"
        },
        {
          "data.assigned_ybs_coach_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.data.self_client_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        },
        {
          "data.trainer_id": "{{user.id}}"
        },
        {
          "data.assigned_ybs_coach_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        },
        {
          "data.trainer_id": "{{user.id}}"
        },
        {
          "data.assigned_ybs_coach_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.managed_workspace_ids}}"
          }
        }
      ]
    }
  }
}